# ── Client (Vite, browser-exposed) ─────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Server only (NEVER prefix with VITE_, never expose to the client) ──
# Supabase URL은 클라이언트용 VITE_SUPABASE_URL을 그대로 사용해도 되지만,
# 서버 함수 환경(예: Vercel)에서는 아래 두 키만 추가 등록해도 동작한다.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

APPS_SCRIPT_WEBHOOK_URL=
APPS_SCRIPT_WEBHOOK_SECRET=
